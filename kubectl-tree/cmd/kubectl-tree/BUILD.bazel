load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "kubectl-tree_lib",
    srcs = [
        "apis.go",
        "namespace.go",
        "query.go",
        "relationship.go",
        "rootcmd.go",
        "status.go",
        "tree.go",
    ],
    importpath = "github.com/ahmetb/kubectl-tree/cmd/kubectl-tree",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_fatih_color//:color",
        "@com_github_gosuri_uitable//:uitable",
        "@com_github_pkg_errors//:errors",
        "@com_github_spf13_cobra//:cobra",
        "@com_github_spf13_pflag//:pflag",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
        "@io_k8s_apimachinery//pkg/runtime/schema",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_apimachinery//pkg/util/duration",
        "@io_k8s_cli_runtime//pkg/genericclioptions",
        "@io_k8s_cli_runtime//pkg/resource",
        "@io_k8s_client_go//discovery",
        "@io_k8s_client_go//dynamic",
        "@io_k8s_client_go//plugin/pkg/client/auth",
        "@io_k8s_client_go//rest",
        "@io_k8s_klog//:klog",
        "@io_k8s_sigs_cli_utils//pkg/kstatus/status",
        "@io_k8s_utils//ptr",
    ],
)

go_binary(
    name = "kubectl-tree",
    embed = [":kubectl-tree_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "kubectl-tree_test",
    srcs = [
        "apis_test.go",
        "status_test.go",
    ],
    embed = [":kubectl-tree_lib"],
    deps = [
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/apis/meta/v1/unstructured",
    ],
)
