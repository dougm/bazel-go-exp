module(name = "kubectl_service_tree")

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.0")

# Keep this plugin's Go dependencies separate from the other plugin's graph.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", isolate = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_fatih_color",
    "com_github_pkg_errors",
    "com_github_replicatedhq_krew_plugin_template",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "io_k8s_api",
    "io_k8s_apimachinery",
    "io_k8s_cli_runtime",
    "io_k8s_client_go",
)
