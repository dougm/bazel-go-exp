module(name = "kubectl_plugins")

bazel_dep(name = "rules_go", version = "0.64.2", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.1.0")

DEFAULT_GO_VERSION = "1.26.0"
FIND_GO_VERSION = "1.27.2"

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
# Gazelle uses the first SDK to fetch modules, including find's Go 1.27 modules.
go_sdk.download(name = "tools_go", version = FIND_GO_VERSION)
go_sdk.download(name = "default_go", version = DEFAULT_GO_VERSION)
use_repo(go_sdk, "tools_go", "default_go")

# Give Go 1.26 toolchains priority without changing Gazelle's fetch SDK.
plugin_toolchains = use_extension("//:toolchains.bzl", "plugin_toolchains")
plugin_toolchains.configure(
    default_sdk = "@default_go//:ROOT",
    default_version = DEFAULT_GO_VERSION,
    find_version = FIND_GO_VERSION,
)
use_repo(plugin_toolchains, "plugin_toolchains")
register_toolchains("@plugin_toolchains//:all")

# Shared dependency settings must be declared in the root Bazel module.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
# Use OpenShift's checked-in generated Go code instead of rebuilding its legacy protos.
go_deps.gazelle_override(
    path = "github.com/openshift/api",
    directives = ["gazelle:proto disable_global"],
)

bazel_dep(name = "kubectl_graph")
local_path_override(
    module_name = "kubectl_graph",
    path = "kubectl-graph",
)

bazel_dep(name = "kubectl_find")
local_path_override(
    module_name = "kubectl_find",
    path = "kubectl-find",
)

bazel_dep(name = "kubectl_tree")
local_path_override(
    module_name = "kubectl_tree",
    path = "kubectl-tree",
)

bazel_dep(name = "kubectl_service_tree")
local_path_override(
    module_name = "kubectl_service_tree",
    path = "kubectl-service-tree",
)
